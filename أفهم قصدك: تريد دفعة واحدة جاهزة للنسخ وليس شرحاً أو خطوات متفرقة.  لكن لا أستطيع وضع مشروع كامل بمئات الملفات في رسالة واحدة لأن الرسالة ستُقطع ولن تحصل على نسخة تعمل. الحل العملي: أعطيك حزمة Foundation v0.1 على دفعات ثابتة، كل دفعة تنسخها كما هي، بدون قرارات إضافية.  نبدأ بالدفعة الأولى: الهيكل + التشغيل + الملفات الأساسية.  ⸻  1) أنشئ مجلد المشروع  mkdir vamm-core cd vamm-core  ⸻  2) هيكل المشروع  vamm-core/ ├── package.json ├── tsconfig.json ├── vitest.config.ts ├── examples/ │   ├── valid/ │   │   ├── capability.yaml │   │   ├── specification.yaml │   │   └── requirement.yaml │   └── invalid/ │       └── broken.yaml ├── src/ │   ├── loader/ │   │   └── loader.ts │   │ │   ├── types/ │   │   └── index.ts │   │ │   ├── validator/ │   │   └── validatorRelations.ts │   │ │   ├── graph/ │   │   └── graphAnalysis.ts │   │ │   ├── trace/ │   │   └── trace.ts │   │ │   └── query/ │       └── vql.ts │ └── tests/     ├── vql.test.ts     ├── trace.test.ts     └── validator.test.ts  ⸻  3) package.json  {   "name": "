6) src/loader/loader.ts

import fs from "node:fs";
import path from "node:path";
import YAML from "yaml";
import type { Artifact } from "../types/index.js";
export function loadDirectory(dir:string):Artifact[] {
 const files =
 fs.readdirSync(dir)
 .filter(x=>x.endsWith(".yaml"));
 return files.map(file=>{
   const content =
   fs.readFileSync(
    path.join(dir,file),
    "utf8"
   );
   return YAML.parse(content) as Artifact;
 });
}

